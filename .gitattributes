# Normalize all text to LF in the repo and working tree (no CRLF checkouts).
* text=auto eol=lf

# Binary assets — do not touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.7z binary
